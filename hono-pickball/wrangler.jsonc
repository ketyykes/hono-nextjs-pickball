{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 名稱必須與 CF Dashboard（Workers Builds）的 Worker 名稱一致，否則 build 會失敗
  "name": "hono-pickball",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  // better-auth / drizzle 依賴 node:crypto 等模組，先行啟用
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // D1 只宣告在 env.local：Workers Builds 執行不帶 --env 的 wrangler deploy，只讀 top-level，
  // 因此誤 push 不會在遠端建立或綁定任何 D1。正式環境的 D1 於 G1 才建立並宣告，
  // 屆時禁止填 placeholder UUID（會讓遠端部署直接失敗）。
  "env": {
    "local": {
      // 具名環境預設會把 worker 命名為 hono-pickball-local，
      // 前端 HONO_API -> hono-pickball 的 service binding 就找不到目標，故明確覆寫
      "name": "hono-pickball",
      // 刻意不填 database_id，避免出現看似真實的 ID
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hono-pickball-local",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
