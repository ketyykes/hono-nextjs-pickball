{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 名稱必須與 CF Dashboard（Workers Builds）的 Worker 名稱一致，否則 build 會失敗
  "name": "hono-pickball",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  // better-auth / drizzle 依賴 node:crypto 等模組，先行啟用
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 正式 D1 宣告於 top-level（Workers Builds 執行不帶 --env 的 wrangler deploy，只讀 top-level）；
  // database_id 不是機密。bindings 不會繼承到具名環境，因此 env.local 另有自己的本機 D1。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hono-pickball",
      "database_id": "9c3a73c2-9a06-4e92-bb6d-90f9cbfda513",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "local": {
      // 具名環境預設會把 worker 命名為 hono-pickball-local，
      // 前端 HONO_API -> hono-pickball 的 service binding 就找不到目標，故明確覆寫
      "name": "hono-pickball",
      // 本機 D1 不需要 database_id，且不得填看似真實的 UUID
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hono-pickball-local",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
